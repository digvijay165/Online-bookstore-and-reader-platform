# Copy this file to .env and fill in your own values.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Set to 1 when the site runs behind HTTPS (enables secure cookies and HSTS).
# HTTPS_ONLY=1

# Set to 1 when running behind a hosting proxy such as Render, Railway or Nginx.
# TRUST_PROXY=1

# HOST=127.0.0.1
# PORT=3000
